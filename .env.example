# Serveur AKWABA
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=false
CORS_ORIGIN=*

# Sécurité JWT (obligatoire >= 32 caractères en production !)
JWT_SECRET=akwaba_dev_secret_change_in_production_225

# Base de données (PostgreSQL Neon en production cloud, ou SQLite local si vide)
DATABASE_URL=
SEED_DEMO_PROFILES=true
ALLOW_DEMO_LOGIN=true
ALLOW_SANDBOX_SIMULATORS=true

# Stockage persistant unifié (VPS / Docker volume)
DATA_DIR=./data
DB_PATH=./data/akwaba.sqlite
UPLOADS_DIR=./data/uploads
BACKUP_KEEP_COUNT=14

# Configuration GeniusPay (https://pay.genius.ci/doc)
# Mode: "sandbox" (simulateur local si clés absentes, ou API sandbox GeniusPay) ou "live"
GENIUSPAY_ENV=sandbox
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_akwaba_local_demo
GENIUSPAY_LOCAL_SIMULATOR=true

# Bouclier Babi — Vérification Téléphone par WhatsApp (Meta WhatsApp Cloud API officiel)
# En l'absence de clés, le serveur utilise le simulateur OTP local en développement
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=akwaba_otp_auth
WHATSAPP_OTP_LANG=fr
WHATSAPP_LOCAL_SIMULATOR=true

# Bouclier Babi — Vérification Selfie 225 Hybride (Gemini Vision + File Modération Admin)
# Si GEMINI_API_KEY est absente, les selfies passent automatiquement en file de modération manuelle
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-4-hydrogen
ADMIN_MODERATION_SECRET=akwaba_dev_mod_225

# Récupération mot de passe par Email (repli si membre sans WhatsApp ou pour hubs Diaspora)
RESEND_API_KEY=
EMAIL_FROM="AKWABA <no-reply@akwaba.ci>"
EMAIL_WEBHOOK_URL=
